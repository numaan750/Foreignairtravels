{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/group-bookings/expire-pending",
      "schedule": "0 0 * * *"
    }
  ],
  "schedules": {
    "ticket-sync": {
      "schedule": "*/15 * * * *",
      "path": "/api/group-ticket-integrations/sync-due",
      "requestMethod": "GET"
    }
  }
}